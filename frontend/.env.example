# ==========================================
# DEVSPACEZ FRONTEND - ENVIRONMENT VARIABLES
# ==========================================

# URL gốc của Backend API (khi chạy local thì là http://localhost:5001/api/v1)
# Khi đưa lên Vercel, hãy đổi thành URL của Render (VD: https://devspacez-backend.onrender.com/api/v1)
VITE_API_URL=http://localhost:5001/api/v1

# URL của Yjs WebSocket (dùng cho Collaboration IDE)
# Local: ws://localhost:5001/yjs
# Production: wss://devspacez-backend.onrender.com/yjs
VITE_WEBSOCKET_URL=ws://localhost:5001/yjs

# Công tắc bật tắt tính năng Docker LSP (đang tạm thời tắt trên nền tảng miễn phí)
# 1 = Bật, 0 = Tắt
VITE_LSP_ENABLED=0
