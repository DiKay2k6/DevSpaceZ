{
    "compilerOptions": {
        "target": "ES2022",
        "module": "Node16", /* FIX 1: Đồng bộ với moduleResolution */
        "moduleResolution": "Node16",
        "outDir": "./dist",
        "rootDir": "..", /* FIX 2: Khai báo rõ thư mục gốc chung là thư mục cha */
        /* Strict Type-Checking Options */
        "strict": true,
        "noImplicitAny": true,
        "strictNullChecks": true,
        /* Module Resolution Options */
        "paths": {
            "@/*": [
                "./src/*"
            ],
            "@shared/*": [
                "../shared/*"
            ]
        },
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": [
        "src/**/*",
        "../shared/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}