{
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5"
  },
  "scripts": {
    "prepare": "husky"
  },
  "lint-staged": {
    "frontend/**/*.{ts,tsx}": [
      "cd frontend && npm run lint",
      "cd frontend && npm run test -- --run"
    ],
    "backend/**/*.ts": [
      "cd backend && npx eslint ."
    ]
  }
}
